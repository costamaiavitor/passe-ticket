# Porta HTTP
PORT=3333
# "production" ativa cookies Secure/SameSite=None e desliga o pagamento simulado
NODE_ENV=development
# Origens do frontend autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
# URL pública desta API (usada nas imagens de capa e no webhook de pagamento)
PUBLIC_URL=http://localhost:3333
# Caminho do banco SQLite
DATABASE_PATH=./data/passe.db

# Segredos — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo
QR_SECRET=troque-este-segredo-tambem

# E-mails que viram administradores ao logar/cadastrar
ADMIN_EMAILS=

# Regras de negócio
PLATFORM_FEE_RATE=0.10
ORDER_RESERVATION_MINUTES=15
MAX_TICKETS_PER_ORDER=10

# Pagamento: "mock" (simulado, só desenvolvimento) ou "mercadopago" (Pix)
PAYMENT_PROVIDER=mock
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
