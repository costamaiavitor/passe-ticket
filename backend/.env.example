# Porta HTTP
PORT=3333
# "production" ativa cookies Secure/SameSite=None e desliga o pagamento simulado
NODE_ENV=development
# Origens do frontend autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
# URL pública desta API (usada nas imagens de capa e no webhook de pagamento)
PUBLIC_URL=http://localhost:3333
# Postgres (Neon). Em branco = usa o Postgres embutido (PGlite) em ./data/pglite, sem instalar nada.
DATABASE_URL=

# Segredos — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo
QR_SECRET=troque-este-segredo-tambem

# E-mails que viram administradores ao logar/cadastrar
ADMIN_EMAILS=

# Regras de negócio
PLATFORM_FEE_RATE=0.10
ORDER_RESERVATION_MINUTES=15
MAX_TICKETS_PER_ORDER=10

# Pagamento: "mock" (simulado, só desenvolvimento) ou "mercadopago" (Pix)
PAYMENT_PROVIDER=mock
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Split 1:1 (organizador conecta o próprio Mercado Pago e recebe direto; a taxa vai para a conta do Passe).
# Em Suas integrações > aplicação do Passe: "Número da aplicação" (MP_CLIENT_ID) e "Client Secret" (MP_CLIENT_SECRET).
# Cadastre também a URL de redirecionamento: https://SEU-SITE/api/v1/mp/oauth/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Chave para criptografar os tokens dos organizadores no banco (opcional; sem ela usa o JWT_SECRET).
TOKEN_ENCRYPTION_KEY=
# Endereço do site para onde o organizador volta depois de conectar (na Vercel é preenchido sozinho).
SITE_URL=
