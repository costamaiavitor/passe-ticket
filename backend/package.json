{
  "name": "passe-ticket-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --import tsx --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --import tsx --env-file-if-exists=.env src/server.ts",
    "seed": "node --import tsx --env-file-if-exists=.env src/seed.ts",
    "test": "NODE_ENV=test node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
